# Enlarger - environment variables
#
# Copy to .env and fill in as needed. .env is gitignored; never commit it.
#
# NOTE: none of these are needed for normal development or for an unsigned
# `npm run dist`. They exist for hand-verifying a signed build locally. In CI
# the values live in GitHub Actions secrets/variables instead -- see
# docs/signing.md.

# --- Azure Artifact Signing: non-secret identifiers -------------------------
# Region-scoped endpoint, e.g. https://eus.codesigning.azure.net
AZURE_SIGNING_ENDPOINT=
# Trusted Signing account name
AZURE_CODE_SIGNING_ACCOUNT=
# Certificate profile name (its subject CN is the publisher users see)
AZURE_CERTIFICATE_PROFILE=

# --- Azure Artifact Signing: Entra ID service principal (SECRETS) -----------
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Build behaviour --------------------------------------------------------
# Set to true to make an unsigned build a hard error. CI sets this itself.
ENLARGER_REQUIRE_SIGNING=
